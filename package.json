{
  "name": "lin4cre-sentinel",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-downloads.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-downloads.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/package-downloads.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "server": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.1.0",
    "typescript": "~5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  }
}
